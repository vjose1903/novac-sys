{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "baseUrl": "./",
    "types": [],
    "paths": {
      "@core/*": ["app/core/*"],
      "@services/*": ["app/core/services/*"],
      "@components/*": ["app/core/components/*"],
      "@registros/*": ["app/admin/registros/*"],
      "@admin/*": ["app/admin/*"],
      "@environments/*": ["environments/*"],
      "@electron/*": ["../electron/*"]
    }
  },
  "files": ["main.ts", "polyfills.ts"],
  "include": ["src/**/*.d.ts"]
}
