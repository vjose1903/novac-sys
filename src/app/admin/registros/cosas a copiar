(paginateChange)="getClientes($event)"


obj_paginate_ = obj_paginate;


this.getClientes(this.obj_paginate_);


async getClientes(e) {
    try {
      const page = e.page;
      const per_page = e.per_page;
      const palabra_a_buscar = e.searchText === '' || e.searchText === null || e.searchText === undefined ? ' ' : e.searchText;

      const res = await this.dbServ.getClientesFiltrados(palabra_a_buscar, page, per_page, true).toPromise();


      this.listaClientes = res.data;

this.fun.toastError('Error buscando articulos registrados.', 'ERROR');



this.subTablaModalChange = this.mServ.TABLA_MODAL_CHANGE.subscribe((res) => {
      if (res) {
        this.pedirClientes(res, res.searchText);
        const obj = {
          data: this.listaClientes,
          filtrarCliente: res.searchText === '' ? ' ' : res.searchText,
        };
        this.mServ.ModalSeleccion(obj);
      }
    });


