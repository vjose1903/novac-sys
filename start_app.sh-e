>>>>>>> actualizaciones
    esac
  else
    echo "${red}**************************************"
    echo "${red}**                                  **"
    echo "${red}**      RUN PART NO ENCONTRADO      **"
    echo "${red}**                                  **"
    echo "${red}**************************************"
    exit 2
  fi
}

npmCommand() {
  echo "${cyan}command ... ${command}"
  echo "${white} "

  command=$1

  npm run $command $is_background
}

while getopts $OPTIONS opt; do
  echo " "
  case "${opt}" in
