#!/bin/bash

green=$(tput setaf 2)
red=$(tput setaf 1)
white=$(tput setaf 7)
yellow=$(tput setaf 3)
cyan=$(tput setaf 6)

OPTIONS="apc:r:s"
PRODUCTION='no'

getActualClient() {
	cliente=$(cat config_setup/actual_cliente.txt)
	echo " "
	echo "${green} ||-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=||"
	echo "${green} ||          ${white}CLIENTE ACTUAL${green}          ||"
	echo "${green} ||-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=||"
	echo " "
	echo "${white}  $cliente"
	echo " "
}

setClient() {
  client=$OPTARG
  if [ "$PRODUCTION" == "no" ]; then nivel='dev'; else nivel='prod'; fi

  echo "${cyan}setClient >> ${client}"
  echo "${green}nivel >> ${nivel}"
  echo "${white} "
  if [ "$client" == "agrodemi" -o "$client" == "brendy" ]; then
    rm app_config.config
    node setup.ts $client $nivel
  else
    echo "${red}*************************************"
    echo "${red}**                                 **"
    echo "${red}**      CLIENTE NO ENCONTRADO      **"
    echo "${red}**                                 **"
    echo "${red}*************************************"
    exit 2
  fi
}

setRunPart() {
  run=$OPTARG

  echo "${yellow}run >> ${run}"
  echo "${white} "

  if [ "$run" == "electron" -o "$run" == "ng" -o "$run" == "all" ]; then
    case "${run}" in
