    echo "la opcion -c"
    setClient
    ;;
  r)
    echo "la opcion -r"
    setRunPart
    ;;
  *)
    echo "${red}*************************************"
    echo "${red}**                                 **"
    echo "${red}**        FLAG NO PERMITIDO        **"
    echo "${red}**                                 **"
