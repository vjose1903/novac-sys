{
  "name": "novac-system",
  "productName": "Novac-System",
  "version": "5.1.22",
  "description": "Sistema facturacion e inventario NOVAC.",
  "author": {
    "name": "Victor Jose Vásquez Santos",
    "email": "vjose1903@outlook.es"
  },
  "keywords": [],
  "main": "main.js",
  "private": true,
  "scripts": {
    "ng": "ng",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "clean": "npm-run-all clean:*",
    "clean:actualizacion": "rimraf ./actualizacion",
    "clean:dist": "rimraf ./dist",

    "start": "npm-run-all -p ng:serve electron:serve",
    "ng:serve": "ng serve --port 5220 -c web",
    "electron:serve": "wait-on tcp:5220 && npm run electron:serve-tsc && npx electron . --serve",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",

    "build": "npm run clean:dist && npm run electron:serve-tsc && ng build --stats-json --base-href ./",
    "build:prod": "npm run build -- -c production",

    "electron:builder-windows": "npm run clean:actualizacion && electron-builder build --windows --x64",

    "windows:dev": "npm run build:prod && npm run electron:builder-windows",
    "windows:prod": "npm run build:prod && npm run electron:builder-windows -- -p always",
    "macos": "npm run build:prod && electron-builder build --mac",

    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "bundle-report": "webpack-bundle-analyzer dist/stats.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vjose1903/novac-system-agrodemi.git"
  },
  "dependencies": {
    "@angular/animations": "^19.0.6",
    "@fortawesome/fontawesome-free": "6.5.2",
    "@mapbox/node-pre-gyp": "1.0.11",
    "@ng-bootstrap/ng-bootstrap": "18.0.0",
    "@popperjs/core": "2.11.8",
    "@primeng/themes": "19.0.5",
    "animate.css": "~4.1.1",
    "bootstrap": "^4.6.2",
    "chart.js": "^4.4.2",
    "child_process": "^1.0.2",
    "del": "^7.1.0",
    "electron-log": "5.1.4",
    "electron-updater": "6.3.9",
    "exceljs": "4.4.0",
    "express": "4.19.2",
    "jquery": "3.7.1",
    "jsbarcode": "3.11.6",
    "ngx-extended-pdf-viewer": "22.2.0-alpha.7",
    "ngx-permissions": "^17.1.0",
    "ngx-toastr": "^18.0.0",
    "pdfmake": "0.2.18",
    "primeicons": "7.0.0",
    "primeng": "19.0.5",
    "replace-in-file": "7.1.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.0.7",
    "@angular-eslint/builder": "17.4.0",
    "@angular-eslint/eslint-plugin": "17.4.0",
    "@angular-eslint/eslint-plugin-template": "17.4.0",
    "@angular-eslint/template-parser": "17.4.0",
    "@angular/build": "^19.0.7",
    "@angular/cli": "19.0.7",
    "@angular/common": "19.0.6",
    "@angular/compiler": "19.0.6",
    "@angular/compiler-cli": "19.0.6",
    "@angular/core": "^19.0.6",
    "@angular/forms": "19.0.6",
    "@angular/language-service": "19.0.6",
    "@angular/localize": "19.0.6",
    "@angular/platform-browser": "19.0.6",
    "@angular/platform-browser-dynamic": "19.0.6",
    "@angular/router": "19.0.6",
    "@types/electron": "1.4.38",
    "@types/jasmine": "5.1.4",
    "@types/jasminewd2": "2.0.13",
    "@types/jquery": "3.5.30",
    "@types/mocha": "10.0.6",
    "@types/node": "20.12.11",
    "core-js": "3.37.0",
    "cross-env": "7.0.3",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "globals": "15.2.0",
    "mocha": "10.4.0",
    "npm-run-all": "4.1.5",
