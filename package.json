{
  "name": "adm-agroindustrial",
  "version": "0.10.0",
  "description": "Sistema facturacion e inventario VjPOS, Para ADM agroindustrial",
  "author": {
    "name": "Victor Jose Vásquez Santos",
    "email": "vjose1903@outlook.es"
  },
  "keywords": [],
  "main": "main.js",
  "private": true,
  "scripts": {
    "postinstall": "npm run postinstall:electron && electron-builder install-app-deps",
    "postinstall:web": "node postinstall-web",
    "postinstall:electron": "node postinstall",
    "node": "node",
    "ng": "ng",
    "init": "npm run postinstall:electron && npm-run-all -p ng:serve electromon:serve",
    "start": "cls; npm run postinstall:electron && npm-run-all -p ng:serve electron:serve",
    "build": "npm run postinstall:electron && npm run electron:serve-tsc && ng build --stats-json ",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build --stats-json  -- -c production",
    "ng:serve": "ng serve --port 5220",
    "web": "npm run postinstall:web && ng serve -o",
    "electron:serve-tsc": "echo ::::: CONVIRTIENDO A JAVASCRIPT ::::::  && tsc -p tsconfig-serve.json",
    "electromon:serve": "wait-on http-get://localhost:5220/ && npm run electron:serve-tsc && node reload/my_electromon.js . --serve",
    "electron:serve": "wait-on http-get://localhost:5220/ && npm run electron:serve-tsc && electron  --no-sandbox . --serve",
    "electron:local": "npm run build:prod && electron .",
    "electron:linux": "npm run build:prod && electron-builder build --linux",
    "electron:windows": "npm run build:prod && electron-builder build --windows",
    "electron:windows64": "npm run build:prod && electron-builder build --windows --x64",
    "electron:mac": "npm run build:prod && electron-builder build --mac",
    "electron:solo": "electron-builder build --windows --x64",
    "test": "npm run postinstall:web && ng test",
    "e2e": "npm run build:prod && mocha --timeout 300000 --require ts-node/register e2e/**/*.spec.ts",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "lint": "ng lint"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "git+https://github.com/angular/angular-devkit-build-angular-builds.git",
    "@angular/cli": "11.2.2",
