{
  "name": "novac-system",
  "productName": "Novac-System",
  "version": "10.5.0",
  "description": "Sistema facturación e inventario NOVAC.",
  "author": {
    "name": "Victor José Vásquez Santos",
    "email": "vjose1903@outlook.es"
  },
  "keywords": [],
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "ng": "ng",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "npm-run-all clean:*",
    "clean:actualizacion": "rimraf ./actualizacion",
    "clean:dist": "rimraf ./dist",
    "start": "npm-run-all -p ng:serve electron:serve",
    "ng:serve": "node scripts/run-dev.js ng",
    "electron:serve": "node scripts/run-dev.js electron",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "build": "npm run clean:dist && ng build --stats-json --base-href ./ && npm run electron:serve-tsc",
    "build:prod": "npm run clean:dist && ng build --stats-json --base-href ./ -c production && npm run electron:serve-tsc",
    "electron:builder-windows": "npm run clean:actualizacion && electron-builder build --windows --x64",
    "windows:dev": "npm run build:prod && npm run electron:builder-windows",
    "windows:prod": "npm run build:prod && npm run electron:builder-windows -- -p always",
    "macos": "npm run build:prod && electron-builder build --mac",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "bundle-report": "npx esbuild-visualizer --metadata=dist/stats.json --open",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@angular/animations": "^21.0.6",
    "@fullcalendar/angular": "7.0.2",
    "@primeuix/themes": "1.2.1",
    "@types/big.js": "6.2.2",
    "@vjose1903/dateutils": "1.0.21",
    "big.js": "7.0.1",
    "bootstrap": "^5.3.7",
    "echarts": "6.1.0",
    "electron-log": "5.1.4",
    "electron-updater": "6.3.9",
    "exceljs": "4.4.0",
    "firebase": "11.9.1",
    "fullcalendar": "7.0.2",
    "jsbarcode": "3.11.6",
    "lodash": "4.18.1",
    "ngx-echarts": "21.0.0",
    "ngx-extended-pdf-viewer": "25.6.4",
    "ngx-permissions": "^19.0.0",
    "ngx-toastr": "^19.0.0",
    "node-machine-id": "1.1.12",
    "pdfmake": "0.2.18",
    "primeicons": "7.0.0",
    "primeng": "21.0.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@angular-eslint/builder": "17.4.0",
    "@angular-eslint/eslint-plugin": "17.4.0",
    "@angular/build": "^21.0.4",
    "@angular/cli": "21.0.4",
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/compiler-cli": "21.0.6",
    "@angular/core": "^21.0.6",
    "@angular/forms": "21.0.6",
    "@angular/language-service": "21.0.6",
    "@angular/localize": "21.0.6",
    "@angular/platform-browser": "21.0.6",
    "@angular/platform-browser-dynamic": "21.0.6",
    "@angular/router": "21.0.6",
    "@types/electron": "1.4.38",
    "@types/jasmine": "5.1.4",
    "@types/mocha": "10.0.6",
    "@types/node": "22.10.5",
    "core-js": "3.37.0",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "mocha": "10.4.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.4.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "spectron": "10.0.1",
    "tslib": "2.6.2",
    "typescript": "5.9.3",
    "wait-on": "7.2.0",
    "zone.js": "~0.15.0"
  },
  "engines": {
    "node": "22.13.1"
  },
  "browserslist": [
    "last 5 Chrome versions"
  ]
}
