{
  "name": "novac-system",
  "productName": "Novac System",
  "version": "3.1.2",
  "description": "Sistema facturacion e inventario NOVAC.",
  "author": {
    "name": "Victor Jose Vásquez Santos",
    "email": "vjose1903@outlook.es"
  },
  "keywords": [],
  "main": "main.js",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npm-run-all -p ng:serve electron:serve",
    "build": "npm run electron:serve-tsc && ng build --stats-json --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "ng:serve": "ng serve --host 0.0.0.0 --port 5220 -c web",
    "electron:serve": "wait-on tcp:5220 && npm run electron:serve-tsc && npx electron . --serve",
    "electron:local": "npm run build:prod && npx electron .",
    "electron:build": "npm run build:prod && electron-builder build",
    "electron:windows64": "tsc -p tsconfig.serve.json && npm run build:prod && electron-builder build --windows --x64 -p always",
    "electron:solo": "tsc -p tsconfig.serve.json && electron-builder build --windows --x64 -p always",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "bundle-report": "webpack-bundle-analyzer dist/stats.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vjose1903/novac-system-agrodemi.git"
  },
