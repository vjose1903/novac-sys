{
  "name": "novac-system",
  "productName": "Novac-System",
  "version": "5.0.8",
  "description": "Sistema facturacion e inventario NOVAC.",
  "author": {
    "name": "Victor Jose Vásquez Santos",
    "email": "vjose1903@outlook.es"
  },
  "keywords": [],
  "main": "main.js",
  "private": true,
  "scripts": {
    "ng": "ng",
    "lint": "eslint .",
    "start": "npm-run-all -p ng:serve electron:serve",
    "build": "npm run electron:serve-tsc && ng build --stats-json --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "ng:serve": "ng serve --port 5220 -c web",
    "electron:serve": "wait-on tcp:5220 && npm run electron:serve-tsc && npx electron . --serve",
    "electron:local": "npm run build:prod && npx electron .",
    "electron:build": "npm run build:prod && electron-builder build",
    "electron:windows64": "tsc -p tsconfig.serve.json && npm run build:prod && electron-builder build --windows --x64 -p always",
    "electron:windows-local": "tsc -p tsconfig.serve.json && npm run build:prod && electron-builder build --windows --x64",
    "electron:macos-local": "tsc -p tsconfig.serve.json && npm run build:prod && electron-builder build --mac",
    "electron:solo": "tsc -p tsconfig.serve.json && electron-builder build --windows --x64",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "bundle-report": "webpack-bundle-analyzer dist/stats.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vjose1903/novac-system-agrodemi.git"
  },
  "dependencies": {
    "@angular/animations": "18.0.2",
    "@fortawesome/fontawesome-free": "6.5.2",
    "@mapbox/node-pre-gyp": "1.0.11",
    "animate.css": "~4.1.1",
    "bootstrap": "^4.6.2",
    "chart.js": "^4.4.2",
    "child_process": "^1.0.2",
    "del": "^7.1.0",
    "electron-log": "5.1.4",
    "electron-updater": "6.1.8",
    "express": "4.19.2",
    "jquery": "3.7.1",
    "jsbarcode": "3.11.6",
    "ngx-extended-pdf-viewer": "20.2.0",
    "ngx-permissions": "^17.1.0",
    "ngx-toastr": "^18.0.0",
    "pdfmake": "^0.2.10",
    "primeicons": "7.0.0",
    "primeng": "17.18.0",
    "replace-in-file": "7.1.0",
    "request": "^2.88.2",
    "@ng-bootstrap/ng-bootstrap": "^17.0.0",
    "@popperjs/core": "2.11.8"
  },
  "devDependencies": {
    "@angular-eslint/builder": "17.4.0",
    "@angular-eslint/eslint-plugin": "17.4.0",
    "@angular-eslint/eslint-plugin-template": "17.4.0",
    "@angular-eslint/template-parser": "17.4.0",
    "@angular/build": "^18.0.3",
    "@angular/cli": "18.0.3",
    "@angular/common": "18.0.2",
    "@angular/compiler": "18.0.2",
    "@angular/compiler-cli": "18.0.2",
    "@angular/core": "^18.0.2",
    "@angular/forms": "18.0.2",
    "@angular/language-service": "18.0.2",
    "@angular/localize": "18.0.2",
    "@angular/platform-browser": "18.0.2",
    "@angular/platform-browser-dynamic": "18.0.2",
    "@angular/router": "18.0.2",
    "@eslint/js": "9.2.0",
    "@types/jasmine": "5.1.4",
    "@types/jasminewd2": "2.0.13",
    "@types/jquery": "3.5.30",
    "@types/mocha": "10.0.6",
    "@types/node": "20.12.11",
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "core-js": "3.37.0",
    "cross-env": "7.0.3",
    "electron": "31.0.1",
    "electron-builder": "24.13.3",
    "eslint": "^8.57.0",
    "globals": "15.2.0",
    "mocha": "10.4.0",
    "npm-run-all": "4.1.5",
    "rxjs": "7.8.1",
    "rxjs-compat": "6.6.7",
    "sas": "~3.0.4",
    "spectron": "10.0.1",
    "ts-node": "10.9.2",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "7.8.0",
    "wait-on": "7.2.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "zone.js": "~0.14.2"
  },
  "engines": {
    "node": ">=10.13.0"
  },
  "browserslist": [
    "chrome 83"
  ]
}
