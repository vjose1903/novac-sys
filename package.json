    "@ng-bootstrap/ng-bootstrap": "^9.0.2",
    "@ng-select/ng-select": "^6.1.0",
    "angular-bootstrap-md": "^10.1.1",
    "angular2-text-mask": "^9.0.0",
    "animate.css": "~4.1.1",
    "bootstrap": "^4.6.0",
    "chart.js": "^2.9.4",
    "child_process": "^1.0.2",
    "del": "^6.0.0",
