function crearPdf(json, callback) {
  // let type_font = "ComicSansMSRegular"
  // let type_font = "comic-sans-ms\\ComicSansMS3"
  let type_font = 'roboto\\Roboto';
  var fontDescriptors = {
    Roboto: {
      normal: PathApp() + 'fonts\\' + type_font + '-Regular.ttf',
      bold: PathApp() + 'fonts\\' + type_font + '-Bold.ttf',
      italics: PathApp() + 'fonts\\' + type_font + '-Italic.ttf',
      bolditalics: PathApp() + 'fonts\\' + type_font + '-BoldItalic.ttf',
    },
  };
  var printer = new pdfmake(fontDescriptors);
  let cFileName = 'factura.pdf';
  try {
    var pdfDoc = printer.createPdfKitDocument(JSON.parse(JSON.stringify(json)));
    pdfDoc.pipe(fs.createWriteStream(cFileName)).on('finish', function () {
      console.log('finizu');
      imprimir(cFileName, callback);
    });
    pdfDoc.end();
  } catch (err) {
    win.webContents.send('print-error', 'Error creando factura!!');
  }
}
try {
  // This method will be called when Electron has finished
  // initialization and is ready to create browser windows.
  // Some APIs can only be used after this event occurs.
  electron_1.app.on('ready', createWindow);
  // Quit when all windows are closed.
  electron_1.app.on('window-all-closed', function () {
    // On OS X it is common for applications and their menu bar
    // to stay active until the user quits explicitly with Cmd + Q
    if (process.platform !== 'darwin') {
      electron_1.app.quit();
    }
  });
  electron_1.app.on('activate', function () {
    // On OS X it's common to re-create a window in the app when the
    // dock icon is clicked and there are no other windows open.
    if (win === null) {
      createWindow();
    }
  });
  electron_1.ipcMain.on('reload-page-numerify', function (event, pam) {
    console.log('voy a reniciar');
    reloadPage();
  });
  electron_1.ipcMain.on('salir', function (event, pam) {
    console.log('voy a salir');
    electron_1.app.quit();
  });
  electron_1.ipcMain.on('print-to-pdf', function (event, pam) {
    console.log('pam', pam);
    crearPdf(pam.data, function (lReturn, err) {
      if (lReturn) {
        win.webContents.send('print-success', {
          impresion: true,
          error: err,
        });
      } else {
        win.webContents.send('print-error', {
          msg: 'Error imprimiendo factura!!',
          error: err,
        });
      }
      // win.webContents.send("print-success", "{impresion: 22 }");
    });
  });
} catch (e) {
