"license": "MIT",
"main": "main.js",
"scripts": {
"postinstall": "electron-builder install-app-deps",
"build:prod": "ng build --prod",
"electron:serve": "wait-on http-get://localhost:4200/ && electron . --serve",
"electron:local": "npm run build:prod && electron .",
"electron:linux": "npm run build:prod && electron-builder build --linux",
"electron:windows32": "npm run build:prod && electron-builder build --windows --ia32",
"electron:windows64": "npm run build:prod && electron-builder build --windows --x64",
"electron:mac": " mv node_modules/electron ../ && npm run build:prod && mv ../electron node_modules/ && electron-builder build --mac",
"ng": "ng",
"start": "ng serve",
"build": "ng build --prod",
"test": "ng test",
"lint": "ng lint",
"e2e": "ng e2e"
},
"private": true,
