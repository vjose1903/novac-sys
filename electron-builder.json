{
  "productName": "adm-agroindustrial",
  "directories": {
    "output": "release/"
  },
  "files": ["**/*", "!myPdf/**/*", "!**/*.ts", "!actualizacion/**/*", "!ADM-dataBase ER.mdj", "!actualizacion.zip", "!print"],
  "win": {
    "icon": "./src/assets/icons/win/icon.ico",
    "asarUnpack": [],
    "target": ["NSIS"]
  },
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "oneClick": false,
    "perMachine": true,
    "installerSidebar": "./src/assets/icons/installer.bmp",
    "uninstallerSidebar": "./src/assets/icons/desinstaller.bmp"
  },
  "mac": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["dmg"]
  },
  "linux": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["AppImage"]
  },
  "publish": [
    {
      "provider": "generic",
      "url": "http://admservidor.ddns.net:9090/actualizacion"
    }
  ]
}
