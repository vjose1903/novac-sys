{
  "appId":"com.inspot-technology.novac",
  "productName": "Novac-System",
  "directories": {
    "output": "actualizacion/"
  },
  "extraMetadata": {
    "main": "dist/out-tsc/main.js"
  },
  "files": [
    "./*",
    "**/*",
    "!**/*.ts",
    "!*.code-workspace",
    "!./LICENSE.md",
    "!./package-lock.json",
    "!./e2e/",
    "!./config_setup/",
    "!./angular.json",
    "!./_config.yml",
    "!./tsconfig.json",
    "!./tslint.json",
    "!./actualizacion/",
    "!./actualizacion.zip",
    "!./log/"
  ],
  "extraFiles": [
    {
      "from": "./print/",
      "to": "resources/print/",
      "filter": [ "**/*" ]
    }
  ],

  "win": {
    "icon": "./src/assets/icons/win/icon.ico",
    "asarUnpack": [],
    "publish": ["github"],
    "target": ["NSIS"]
  },
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "oneClick": false,
    "perMachine": true,
    "installerSidebar": "./src/assets/icons/installer.bmp",
    "uninstallerSidebar": "./src/assets/icons/desinstaller.bmp"
  },
  "mac": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["dmg"]
  },
  "linux": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["AppImage"]
  }
}
