{
  "productName": "adm-agroindustrial",
  "directories": {
    "output": "release/"
  },
  "win": {
    "icon": "./icons/win/icon.ico",
    "asarUnpack": [
      "./fonts/**/*",
      "./print/**/*",
      "./myPdf/**/*",
      "./icons/**/*",
      "./node_modules/lodash/**/*",
      "./node_modules/moment/**/*"
    ],
    "target": [
      "NSIS"
    ]
  },
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "oneClick": false,
    "perMachine": true,
    "installerSidebar": "./icons/installer.bmp",
    "uninstallerSidebar": "./icons/desinstaller.bmp"
  },
  "mac": {
    "icon": "./icons/mac/icon.icns",
    "target": [
      "dmg"
    ]
  },
  "linux": {
    "icon": "./icons/mac/icon.icns",
    "target": [
      "AppImage"
    ]
  },
  "publish": [
    {
    "provider": "generic",
    "url": "http://admservidor.ddns.net:3000/actualizacion"
    }
    ]
}
