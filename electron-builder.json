{
  "appId":"com.inspot-technology.novac",
  "productName": "Novac-System",
  "directories": {
    "output": "actualizacion/"
  },
  "extraMetadata": {
    "main": "main.js"
  },
  "files": [
    {
      "from": ".",
      "to": ".",
      "filter": [
        "package.json",
        "main.js",
        "dist/**/*",
        "electron/**/*.js",
        "electron/**/*.json",
        "logos.json",
        "actual_cliente.json",
        "fb.config",
        "app_config.config"
      ]
    }
  ],
  "extraFiles": [
    {
      "from": "./print/",
      "to": "resources/print/",
      "filter": [ "**/*" ]
    }
  ],

  "win": {
    "icon": "./src/assets/icons/win/icon.ico",
    "asarUnpack": [],
    "publish": ["github"],
    "target": ["NSIS"]
  },
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "oneClick": false,
    "perMachine": true,
    "installerSidebar": "./src/assets/icons/installer.bmp",
    "uninstallerSidebar": "./src/assets/icons/desinstaller.bmp"
  },
  "mac": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["dmg"]
  },
  "linux": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["AppImage"]
  }
}
