{
  "appId": "com.inspot-technology.novac",
  "productName": "Novac-System",
  "directories": {
    "output": "actualizacion/"
  },
  "extraMetadata": {
    "main": "dist/electron/main.js"
  },
  "files": [
    {
      "from": ".",
      "to": ".",
      "filter": [
        "package.json",
        "dist/browser/**/*",
        "dist/electron/**/*",
        "actual_cliente.json",
        "fb.config",
        "app_config.config"
      ]
    },
    {
      "from": ".",
      "to": "dist/electron",
      "filter": ["logos.json"]
    },
    {
      "from": "electron",
      "to": "dist/electron/electron",
      "filter": ["*.json"]
    }
  ],
  "extraFiles": [
    {
      "from": "./print/",
      "to": "resources/print/",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "./src/assets/icons/win/icon.ico",
    "asarUnpack": [],
    "publish": [
      {
        "provider": "github",
        "owner": "vjose1903",
        "repo": "novac-system-brendy",
        "releaseType": "release"
      }
    ],
    "target": ["NSIS"]
  },
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "oneClick": false,
    "perMachine": true,
    "installerSidebar": "./src/assets/icons/installer.bmp",
    "uninstallerSidebar": "./src/assets/icons/desinstaller.bmp"
  },
  "mac": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["dmg"]
  },
  "linux": {
    "icon": "./src/assets/icons/mac/icon.icns",
    "target": ["AppImage"]
  }
}
