{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "declaration": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "lib": ["ES2023", "dom"]
  },
  "files": ["main.ts", "electron/preload.ts"],
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules", "src/**", "config_setup/**", "**/*.spec.ts"]
}
